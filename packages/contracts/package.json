{
  "name": "@synara/contracts",
  "version": "1.0.5",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    "./ahaSkins": {
      "types": "./src/ahaSkins.ts",
      "import": "./src/ahaSkins.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./ahaAppearance": {
      "types": "./src/ahaAppearance.ts",
      "import": "./src/ahaAppearance.ts"
    },
    "./ahaLegacyAppearance": {
      "types": "./src/ahaLegacyAppearance.ts",
      "import": "./src/ahaLegacyAppearance.ts"
    },
    "./ahaChannels": {
      "types": "./src/ahaChannels.ts",
      "import": "./src/ahaChannels.ts"
    },
    "./resourceLibrary": {
      "types": "./src/resourceLibrary.ts",
      "import": "./src/resourceLibrary.ts"
    },
    "./spriteLibrary": {
      "types": "./src/spriteLibrary.ts",
      "import": "./src/spriteLibrary.ts"
    },
    "./spriteLibrarySchema": {
      "types": "./src/spriteLibrarySchema.ts",
      "import": "./src/spriteLibrarySchema.ts"
    },
    "./imageSize": {
      "types": "./src/imageSize.ts",
      "import": "./src/imageSize.ts"
    }
  },
  "scripts": {
    "dev": "tsdown src/index.ts --format cjs --watch --clean",
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:native": "bun run typecheck",
    "typecheck:legacy": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "catalog:",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
